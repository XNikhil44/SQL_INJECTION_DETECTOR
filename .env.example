# Copy to .env and fill in. Never commit .env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=15

# Optional: require X-API-Key header on all /api/* calls (except /api/health)
# API_KEY=

DB_PATH=sqli_detector.db
RATE_LIMIT_PER_MIN=60

# Keep false. Only enable if you really need to scan public IPs you own.
ALLOW_PUBLIC_SCAN=false
